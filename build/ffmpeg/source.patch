 #include <stdatomic.h>
+#include <stdarg.h>
 
 #include "libavutil/avassert.h"
 #include "libavutil/avstring.h"
@@ -49,6 +50,25 @@
 
 #if CONFIG_LIBV4L2
 #include <libv4l2.h>
+
+/* libv4l2 uses an unsigned long request even on POSIX-ioctl platforms. */
+#if HAVE_POSIX_IOCTL
+static int libv4l2_ioctl(int fd, int request, ...)
+#else
+static int libv4l2_ioctl(int fd, unsigned long request, ...)
+#endif
+{
+    va_list args;
+    void *arg;
+    va_start(args, request);
+    arg = va_arg(args, void *);
+    va_end(args);
+#if HAVE_POSIX_IOCTL
+    return v4l2_ioctl(fd, (unsigned long)(unsigned int)request, arg);
+#else
+    return v4l2_ioctl(fd, request, arg);
+#endif
+}
 #endif
 
 static const int desired_video_buffers = 256;
